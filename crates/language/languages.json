    "id": "ignore", "name": "Ignore",
    "extensions": [".gitignore", ".dockerignore", ".npmignore"],
    "filenames": [".gitignore", ".dockerignore", ".npmignore", ".ignore", ".prettierignore", ".eslintignore"],
    "lineComment": "#"
  },
  {
    "id": "diff", "name": "Diff", "aliases": ["patch"],
    "extensions": [".diff", ".patch", ".rej"],
    "grammar": "diff"
  },
  {
    "id": "git-commit", "name": "Git Commit Message",
    "filenames": ["COMMIT_EDITMSG", "MERGE_MSG"],
    "lineComment": "#"
  },
  {
    "id": "scala", "name": "Scala",
    "extensions": [".scala", ".sc", ".sbt"],
    "lineComment": "//", "blockComment": ["/*", "*/"],
    "grammar": "scala",
    "keywords": ["abstract", "case", "class", "def", "enum", "extends", "final", "given", "implicit", "import", "lazy", "new", "object", "override", "package", "private", "protected", "sealed", "super", "this", "trait", "type", "using", "val", "var", "with", "true", "false", "null"],
    "controlKeywords": ["catch", "do", "else", "finally", "for", "if", "match", "return", "then", "throw", "try", "while", "yield"],
    "languageServer": { "command": "metals", "heavy": true }
  },
  {
    "id": "elixir", "name": "Elixir",
    "extensions": [".ex", ".exs"],
    "lineComment": "#",
    "grammar": "elixir",
    "keywords": ["def", "defp", "defmodule", "defstruct", "defmacro", "do", "end", "fn", "alias", "import", "require", "use", "true", "false", "nil"],
    "controlKeywords": ["case", "cond", "else", "if", "unless", "when", "with", "rescue", "catch", "raise", "try", "receive"],
    "languageServer": { "command": "elixir-ls", "install": "brew install elixir-ls" }
  },
  {
    "id": "haskell", "name": "Haskell",
    "extensions": [".hs", ".lhs"],
    "lineComment": "--", "blockComment": ["{-", "-}"],
    "grammar": "haskell",
    "keywords": ["class", "data", "deriving", "forall", "import", "infix", "infixl", "infixr", "instance", "let", "module", "newtype", "qualified", "type", "where", "True", "False"],
    "controlKeywords": ["case", "do", "else", "if", "in", "of", "then"],
    "languageServer": { "command": "haskell-language-server-wrapper", "heavy": true, "install": "ghcup install hls", "args": ["--lsp"] }
  }
]
