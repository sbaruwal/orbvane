  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6E6D68"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": "keyword, storage.type, storage.modifier",
      "settings": {
        "foreground": "#6DA7EC"
      }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#6DA7EC"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#898781"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#93BF8C"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#D6B27A"
      }
    },
    {
      "name": "Constants",
      "scope": "constant, variable.other.constant, variable.other.enummember",
      "settings": {
        "foreground": "#D6B27A"
      }
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type, support.class, entity.name.class",
      "settings": {
        "foreground": "#B7C1D1"
      }
    },
    {
      "name": "Type parameters",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#B7C1D1"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#E8E6E0"
      }
    },
    {
      "name": "Macros",
      "scope": "entity.name.function.macro",
      "settings": {
        "foreground": "#D6B27A"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#C3C2B7"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#CFCDC4"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#BDBBB2"
      }
    },
    {
      "name": "Namespaces",
      "scope": "entity.name.namespace",
      "settings": {
        "foreground": "#ADABA3"
      }
    },
    {
      "name": "Attributes and tags",
      "scope": "entity.other.attribute-name, meta.attribute",
      "settings": {
        "foreground": "#898781"
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#6DA7EC"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#898781"
      }
    },
    {
      "name": "Lifetimes",
      "scope": "storage.modifier.lifetime, entity.name.type.lifetime",
      "settings": {
        "foreground": "#6DA7EC"
      }
    },
    {
      "name": "Markup headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#6DA7EC"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#E5716F"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ADABA3",
    "parameter": "#CFCDC4",
    "property": "#BDBBB2",
    "enumMember": "#D6B27A",
    "typeParameter": "#B7C1D1",
    "macro": "#D6B27A",
    "variable.readonly": "#D6B27A",
    "*.mutable": "#F0EFEC",
    "selfKeyword": "#6DA7EC",
    "lifetime": "#6DA7EC",
    "builtinType": "#B7C1D1",
    "attribute": "#898781"
  }
}
