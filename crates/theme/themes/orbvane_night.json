  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#6F6A90"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": "keyword, storage.type, storage.modifier",
      "settings": {
        "foreground": "#A98AFF"
      }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#EE8FE0"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#A6A2C4"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#9DE3B4"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#FFC76B"
      }
    },
    {
      "name": "Constants",
      "scope": "constant, variable.other.constant, variable.other.enummember",
      "settings": {
        "foreground": "#FFB077"
      }
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type, support.class, entity.name.class",
      "settings": {
        "foreground": "#5ED9CF"
      }
    },
    {
      "name": "Type parameters",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#8DE6DE"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#88B4FF"
      }
    },
    {
      "name": "Macros",
      "scope": "entity.name.function.macro",
      "settings": {
        "foreground": "#F4A261"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#DAD7EE"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#F2C9AA"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#CFCBF2"
      }
    },
    {
      "name": "Namespaces",
      "scope": "entity.name.namespace",
      "settings": {
        "foreground": "#9CC8FF"
      }
    },
    {
      "name": "Attributes and tags",
      "scope": "entity.other.attribute-name, meta.attribute",
      "settings": {
        "foreground": "#9A95BA"
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#A98AFF"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#A6A2C4"
      }
    },
    {
      "name": "Lifetimes",
      "scope": "storage.modifier.lifetime, entity.name.type.lifetime",
      "settings": {
        "foreground": "#EE8FE0"
      }
    },
    {
      "name": "Markup headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#A98AFF"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#F7768E"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9CC8FF",
    "parameter": "#F2C9AA",
    "property": "#CFCBF2",
    "enumMember": "#FFB077",
    "typeParameter": "#8DE6DE",
    "macro": "#F4A261",
    "variable.readonly": "#FFB077",
    "*.mutable": "#F2E9FF",
    "selfKeyword": "#A98AFF",
    "lifetime": "#EE8FE0",
    "builtinType": "#5ED9CF",
    "attribute": "#9A95BA"
  }
}
