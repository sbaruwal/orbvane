  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#8C87A6"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": "keyword, storage.type, storage.modifier",
      "settings": {
        "foreground": "#6A3FD6"
      }
    },
    {
      "name": "Control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#A8329A"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#57526F"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#2E7D50"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#B05F00"
      }
    },
    {
      "name": "Constants",
      "scope": "constant, variable.other.constant, variable.other.enummember",
      "settings": {
        "foreground": "#B8530F"
      }
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type, support.class, entity.name.class",
      "settings": {
        "foreground": "#0B807A"
      }
    },
    {
      "name": "Type parameters",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#2C9A92"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#2457C5"
      }
    },
    {
      "name": "Macros",
      "scope": "entity.name.function.macro",
      "settings": {
        "foreground": "#B5521B"
      }
    },
    {
      "name": "Variables",
      "scope": "variable",
      "settings": {
        "foreground": "#24203A"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#8E4A1C"
      }
    },
    {
      "name": "Properties",
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#4A447E"
      }
    },
    {
      "name": "Namespaces",
      "scope": "entity.name.namespace",
      "settings": {
        "foreground": "#1D6AA3"
      }
    },
    {
      "name": "Attributes and tags",
      "scope": "entity.other.attribute-name, meta.attribute",
      "settings": {
        "foreground": "#6E6990"
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#6A3FD6"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#57526F"
      }
    },
    {
      "name": "Lifetimes",
      "scope": "storage.modifier.lifetime, entity.name.type.lifetime",
      "settings": {
        "foreground": "#A8329A"
      }
    },
    {
      "name": "Markup headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#6A3FD6"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#D2364F"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#1D6AA3",
    "parameter": "#8E4A1C",
    "property": "#4A447E",
    "enumMember": "#B8530F",
    "typeParameter": "#2C9A92",
    "macro": "#B5521B",
    "variable.readonly": "#B8530F",
    "*.mutable": "#1B1640",
    "selfKeyword": "#6A3FD6",
    "lifetime": "#A8329A",
    "builtinType": "#0B807A",
    "attribute": "#6E6990"
  }
}
